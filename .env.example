# Copy this file to .env before starting the local stack. Do not commit .env.
# Values below are development-only placeholders; replace every password/secret.

POSTGRES_USER=timesheet
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432
IDENTITY_DB_PASSWORD=change-this-identity-db-password
TIMESHEET_DB_PASSWORD=change-this-timesheet-db-password
REPORTING_DB_PASSWORD=change-this-reporting-db-password
NOTIFICATION_DB_PASSWORD=change-this-notification-db-password

GATEWAY_API_PORT=8081
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
TIMESHEET_REMOTE_PORT=3002
REPORTING_REMOTE_PORT=3003
ADMINISTRATION_REMOTE_PORT=3004
IDENTITY_PROFILE_REMOTE_PORT=3005

REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379

# Generate a 32-byte base64 seed and a separate random key of at least 32 characters.
PASETO_SIGNING_SEED=replace-with-base64-encoded-32-byte-random-seed
NOTIFICATION_INTERNAL_KEY=replace-with-random-internal-api-key-at-least-32-characters
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=

RABBITMQ_USER=timesheet
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RUSTFS_ACCESS_KEY=TIMESHEETLOCAL
RUSTFS_SECRET_KEY=change-this-rustfs-secret
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# MailDev is optional because an existing local MailDev instance may already own
# these ports. Start it only with: docker compose --profile maildev up -d
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=8080
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM=no-reply@aiyara.local
SMTP_USERNAME=
SMTP_PASSWORD=

# Observability starts with the core local platform.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
