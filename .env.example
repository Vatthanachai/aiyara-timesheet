# Copy this file to .env before starting the local stack. Do not commit .env.
# Values below are development-only placeholders; replace every password/secret.

POSTGRES_USER=timesheet
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

GATEWAY_API_PORT=8081
IDENTITIES_API_PORT=8082
TIMESHEET_API_PORT=8083
REPORTS_API_PORT=8084
FRONTEND_PORT=3000

REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379

RABBITMQ_USER=timesheet
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RUSTFS_ACCESS_KEY=TIMESHEETLOCAL
RUSTFS_SECRET_KEY=change-this-rustfs-secret
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# MailDev is optional because an existing local MailDev instance may already own
# these ports. Start it only with: docker compose --profile maildev up -d
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=8080

# Observability is optional. Start it with:
# docker compose --profile observability up -d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
