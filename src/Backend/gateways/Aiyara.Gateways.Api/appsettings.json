{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "FrontendOrigin": "http://localhost:3000"
  },
  "Services": {
    "Identity": {
      "BaseUrl": "http://localhost:5027"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-docs": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api-docs/identity/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api-docs/identity" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-User-Id" }
        ]
      },
      "timesheet-docs": {
        "ClusterId": "timesheet",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api-docs/timesheet/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api-docs/timesheet" }]
      },
      "reporting-docs": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api-docs/reporting/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api-docs/reporting" }]
      },
      "notification-docs": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api-docs/notification/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api-docs/notification" }]
      },
      "identity-api": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "TenantMember",
        "Match": { "Path": "/api/v1/identity/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/identity" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "timesheet-api": {
        "ClusterId": "timesheet",
        "AuthorizationPolicy": "TenantMember",
        "Match": { "Path": "/api/v1/timesheets/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/timesheets" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "reporting-api": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "TenantMember",
        "Match": { "Path": "/api/v1/reports/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/reports" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "notification-api": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "TenantMember",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/notifications" },
          { "PathPrefix": "/api/v1" }
        ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5027/" } } },
      "timesheet": { "Destinations": { "primary": { "Address": "http://localhost:5198/" } } },
      "reporting": { "Destinations": { "primary": { "Address": "http://localhost:5160/" } } },
      "notification": { "Destinations": { "primary": { "Address": "http://localhost:57087/" } } }
    }
  }
}
